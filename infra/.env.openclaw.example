# openclaw infrastructure environment example
#
# Copy to .env.openclaw and fill in actual values. NEVER commit .env.openclaw.
# Real secrets do not live here in production — vault-agent renders them
# into /run/secrets/openclaw/* at container start. This file holds only
# bootstrap and non-secret config.

# Deployment environment
OC_ENV=development
OC_LOG_LEVEL=info

# MinIO bootstrap credentials (rotated after first run; production creds
# come from Vault via vault-agent — these are dev-only).
MINIO_ROOT_USER=oc-bootstrap
MINIO_ROOT_PASSWORD=CHANGEME-bootstrap-only-rotate-immediately
